        <mxCell id="g_external" value="EXTERNAL SERVICES LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#080E1A;strokeColor=#EC4899;strokeWidth=2;dashed=1;align=center;verticalAlign=top;fontColor=#F472B6;fontStyle=1;fontSize=12;spacingTop=10;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="180" width="200" height="300" as="geometry" />
        </mxCell>
        <mxCell id="react_frontend" value="&lt;b&gt;React 19 Frontend Web Client&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Single Page Application (SPA)&lt;br/&gt;• PickATrip Travel Wizard&lt;br/&gt;• Mapbox GL / Leaflet Maps&lt;br/&gt;• Multi-language i18n support&lt;br/&gt;• Floating EcoBot Chat UI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1E293B;gradientColor=#0B1329;strokeColor=#38BDF8;strokeWidth=2.5;fontColor=#FFFFFF;fontSize=11.5;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="firebase_db" value="&lt;b&gt;Firebase Cloud Database&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Firestore destinations collection&lt;br/&gt;• Realtime DB bookings &amp; metrics&lt;br/&gt;• Secure JSON Database rules&lt;br/&gt;• Sub-second client sync stream" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#1E293B;gradientColor=#1E1B4B;strokeColor=#F59E0B;strokeWidth=2.5;fontColor=#FFFFFF;fontSize=11.5;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="80" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fastapi_backend" value="&lt;b&gt;FastAPI Python Backend&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Scikit-learn BallTree (Haversine)&lt;br/&gt;• Travel Routing &amp; Cost Calculator&lt;br/&gt;• Real-time Firestore Sync listener&lt;br/&gt;• Amadeus Flights API Simulator&lt;br/&gt;• Thread-safe RLock mechanism" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1E293B;gradientColor=#064E3B;strokeColor=#34D399;strokeWidth=2.5;fontColor=#FFFFFF;fontSize=11.5;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n8n_engine" value="&lt;b&gt;n8n.io Automation Engine&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Webhook gateway for chat messages&lt;br/&gt;• Stripe payment success webhook&lt;br/&gt;• Automated SMTP Email templates&lt;br/&gt;• OpenAI LLM Node Integrations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1E293B;gradientColor=#7C2D12;strokeColor=#FB923C;strokeWidth=2.5;fontColor=#FFFFFF;fontSize=11.5;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="300" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="mem_cache" value="&lt;b&gt;In-Memory Cache (RAM)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Thread-locked Pandas DataFrames&lt;br/&gt;• Pre-built destinations BallTree&lt;br/&gt;• Pre-built hotels BallTree&lt;br/&gt;• Query latency: &amp;lt; 5ms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1E293B;gradientColor=#1E1B4B;strokeColor=#818CF8;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="510" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="local_fs" value="&lt;b&gt;Local Filesystem&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Destination Site.csv&lt;br/&gt;• Hotels .csv / airports.csv&lt;br/&gt;• CSV persistence writeback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1E293B;gradientColor=#334155;strokeColor=#94A3B8;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;shadow=1;" vertex="1" parent="1">
