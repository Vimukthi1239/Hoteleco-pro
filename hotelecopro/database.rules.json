{
    "rules": {
        "destinations": {
            ".read": true,
            ".write": true,
            ".indexOn": [
                "createdAt",
                "district"
            ]
        },
        "bookings": {
            ".read": "auth != null",
            ".write": true,
            ".indexOn": [
                "createdAt",
                "hotelId",
                "hotel"
            ]
        },
        "hotelRegistrations": {
            ".read": true,
            ".write": true,
            ".indexOn": [
                "createdAt",
                "status",
                "email"
            ]
        },
        "hotelProfiles": {
            ".read": true,
            ".write": true
        },
        "contactMessages": {
            ".read": "auth != null",
            ".write": true,
            ".indexOn": [
                "createdAt"
            ]
        },
        "hotelMetrics": {
            ".read": "auth != null",
            ".write": "auth != null",
            "$hotelId": {
                ".indexOn": [
                    "updatedAt"
                ]
            }
        }
    }
}