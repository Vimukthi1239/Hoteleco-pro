# Python ML Backend URL (Deployed on Render.com)
REACT_APP_API_URL="https://your-render-backend.onrender.com"

# Firebase Credentials
REACT_APP_FIREBASE_API_KEY=""
REACT_APP_FIREBASE_AUTH_DOMAIN=""
